# Copie para .env.local (desenvolvimento) ou defina como variável do serviço (produção).
# Endereço interno da API (só localhost; nunca exposto ao navegador).
PORTAL_API_INTERNAL_URL=http://127.0.0.1:5080
# Chave pública do Cloudflare Turnstile. Vazia desliga o captcha (a secreta fica na API: Captcha__TurnstileSecret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
